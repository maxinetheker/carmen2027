APP_NAME="Carmen Mestanza Inmobiliaria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://carmenmestanza.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_BASE
DB_USERNAME=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_CLAVE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.carmenmestanza.com
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR_SMTP
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_USUARIO_SMTP
MAIL_PASSWORD=CAMBIAR_CLAVE_SMTP
MAIL_FROM_ADDRESS=notificaciones@carmenmestanza.com
MAIL_FROM_NAME="Carmen Mestanza Inmobiliaria"

CRM_ADMIN_EMAIL=CAMBIAR_CORREO_PRINCIPAL
CRM_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_DATA=false
PUBLIC_STORAGE_URL=/storage

GOOGLE_MAPS_API_KEY=
VITE_APP_NAME="${APP_NAME}"
