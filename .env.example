APP_NAME="Carmen Mestanza Inmobiliaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://carmenmestanza.com
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Habilita el mapa oficial de Google en las fichas públicas.
GOOGLE_MAPS_API_KEY=

# Configure estos valores localmente; no publique credenciales reales.
CRM_ADMIN_EMAIL=carmen@example.com
CRM_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_DATA=false

# Notificaciones push de la app Android (Firebase Cloud Messaging).
# FCM_PROJECT_ID es el "Project ID" del proyecto Firebase (no el nombre visible).
# Deja FCM_CREDENTIALS_PATH vacío: por defecto se usa storage/app/firebase/service-account.json
# dentro del propio proyecto (esa carpeta está excluida del control de versiones).
# Ahí va el JSON de la cuenta de servicio descargado desde Firebase Console >
# Configuración del proyecto > Cuentas de servicio.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
